<!DOCTYPE html>
<html lang="fr">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Merci — BoosterX Media</title>
  <meta name="robots" content="noindex">
  <script src="https://cdn.tailwindcss.com"></script>

  <!-- TikTok Pixel Code Start -->
